{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".verify-out",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/data/**/*.ts", "scripts/**/*.ts"]
}
